<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Orchestrator.Api</RootNamespace>
    <!-- install.ps1 sets this so the server started at login shows no console window. (Passing -p:OutputType=WinExe
         instead would also apply to the Core library and break its build.) -->
    <OutputType Condition="'$(OrchestratorWindowless)' == 'true'">WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orchestrator.Core\Orchestrator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

</Project>
