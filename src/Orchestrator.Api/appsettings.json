{
  "Urls": "http://127.0.0.1:7777",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Orchestrator": {
    "DefaultRepository": null,
    "AllowedRepositoryRoots": [],
    "WorktreeDirectory": ".orchestrator/worktrees",
    "BranchPrefix": "orchestrator/",
    "MaxConcurrentTasks": 3,
    "DefaultTimeoutMinutes": 60,
    "IdleTimeoutMinutes": 15,
    "MaxDepth": 2,
    "CopyIntoWorktree": [],
    "ApiKey": null,
    "Agents": {
      "claude": {
        "Enabled": true,
        "Executable": "claude",
        "MaxConcurrent": 2,
        "ExtraArgs": [ "--permission-mode", "acceptEdits", "--permission-prompts", "none" ]
      },
      "codex": {
        "Enabled": true,
        "Executable": "codex",
        "MaxConcurrent": 2,
        "ExtraArgs": [ "--sandbox", "workspace-write" ]
      },
      "qoder": {
        "Enabled": true,
        "Executable": "qodercli",
        "MaxConcurrent": 2,
        "ExtraArgs": [ "--permission-mode", "accept_edits" ]
      },
      "opencode": {
        "Enabled": true,
        "Executable": "opencode",
        "MaxConcurrent": 2,
        "AttachUrl": null,
        "ExtraArgs": [ "--auto" ],
        "Environment": {
          "OPENCODE_PERMISSION": "{\"bash\":{\"*\":\"allow\",\"git push*\":\"deny\",\"git reset --hard*\":\"deny\",\"git checkout *\":\"deny\",\"git switch *\":\"deny\",\"git worktree *\":\"deny\"},\"external_directory\":\"deny\"}"
        }
      }
    }
  }
}
